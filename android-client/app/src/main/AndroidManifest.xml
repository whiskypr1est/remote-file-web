<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 只在 Android 9 及以下需要：把下载的文件写进公共「下载」目录。
         Android 10+ 由系统的 DownloadManager 代写，不再需要这个权限，
         所以用 maxSdkVersion 限住，免得在新系统上白白多要一个敏感权限。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!--
          ★ usesCleartextTraffic 是必需的：本服务在局域网里走的是明文 http
            （Android 9+ 默认禁止明文流量，不开这个连不上）。
            这里就是「局域网内互相信任」那个既有前提的延伸 —— 所以
            **不要**把这个 App 的地址填成公网地址，那等于把口令和
            一台真 shell 暴露到互联网上。
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|density|uiMode|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <!--
              screenOrientation=sensorLandscape：桌面隐喻在横屏才成立
              （竖屏下窗口会挤成一团）。想跟随重力感应就删掉这一行。

              configChanges 里那一长串是刻意的：旋转、接上/拔掉蓝牙键盘时
              **不要重建 Activity** —— 重建会丢掉 WebView 的登录会话与
              已经打开的窗口，那对办公来说非常烦人。

              windowSoftInputMode=adjustResize：外接键盘时无所谓，
              但拔掉键盘用软键盘时，resize 才能让终端不被输入法盖住。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
