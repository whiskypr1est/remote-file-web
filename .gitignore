# ===========================================================================
#  远程文件管理 —— 版本控制忽略清单
#
#  ★ 本文件存在的首要理由是「不把密钥和口令推到远端」。
#    config.json 里有 session_secret（可用于伪造会话 Cookie）与口令哈希，
#    FIRST_RUN_PASSWORD.txt 里是明文口令 —— 这两个**永远不要提交**。
#    需要模板请用 config.example.json（其中的值都是占位符）。
# ===========================================================================

# ---- 运行时生成，含密钥 / 口令 --------------------------------------------
config.json
FIRST_RUN_PASSWORD.txt
# 用户表（多用户改造后引入）：含**每个用户的口令哈希**，属于部署数据。
# 服务首次启动时会从 config.json 的 auth 段自动派生管理员并生成它
# （见 fileweb/users.py 的 ensure_bootstrap），所以既不需要、也绝不能进仓库。
users.json

# ---- 每台机器 / 每个人各自的状态（属于部署数据，不属于源码）--------------
user_state.json
desktop_shortcuts.json
# 多用户之后这两类文件**按用户各一份**（user_state.<用户名>.json 等），
# 显式的两个名字挡不住它们，所以用通配。
user_state.*.json
desktop_shortcuts.*.json

# 审计日志：含登录 IP、用户名与时间，属于部署数据；轮转出来的也要挡
audit.log.jsonl
audit.log.jsonl.*

# ---- 音乐播放器（虚拟桌面内置）------------------------------------------
# 曲库是**文件系统里的目录**（导入=把文件复制进去），显然不该进仓库。
# 用 /music/ 锚定到项目根目录，免得将来有个叫 music 的源码目录被一起忽略。
/music/
# 歌单与播放偏好（按用户分文件）
music_state.json
music_state.*.json

# ---- 照片（虚拟桌面内置的时间轴相册）------------------------------------
# ★ 这两个文件里有**用户的个人信息**：photos_state.json 是照片的拍摄时间、
#   地点、标签与相册（自己改过的时间地点都在这里），photo_index.json 是
#   本机照片的路径与 EXIF。它们属于部署数据，绝不该进仓库。
#   多用户下这两类同样按用户各一份（photos_state.<用户名>.json 等）。
photos_state.json
photos_state.*.json
photo_index.json
photo_index.*.json
# 从浏览器上传的照片落点（体积大、且是用户自己的东西）。
# 用 /photos_uploads/ 锚定到项目根目录，免得将来有同名源码目录被一起忽略。
/photos_uploads/

# ---- 安卓客户端（android-client/）的构建产物 ------------------------------
# ★ 必须排除：Gradle 一次构建就会产生几百 MB（app/build/ 与 .gradle/），
#   不加的话 `git add -A` 会把它们连同一堆中间产物一起提交上去。
#   local.properties 存的是**本机**的 Android SDK 路径，换机器就失效。
#   （.apk 本身不在这里统一忽略 —— 它已经被 build/ 盖住了；
#     将来若要刻意提交某个发布包，用 git add -f 明确地加。）
android-client/local.properties
android-client/.gradle/
android-client/build/
android-client/**/build/
android-client/captures/
android-client/.idea/
android-client/*.iml

# ---- 运行时缓存与临时产物 -------------------------------------------------
thumb_cache/
office_cache/
temp_zip/
logs/
*.log

# ---- 用户在界面上传的自定义壁纸（体积大且因人而异）----------------------
static/wallpapers/

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 本地 AI / 工具链产物（不属于本项目）-------------------------------
.dsh-vision-toolkit/

# ---- 编辑器与操作系统 -----------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
