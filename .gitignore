# ===========================================================================
#  远程文件管理 —— 版本控制忽略清单
#
#  ★ 本文件存在的首要理由是「不把密钥和口令推到远端」。
#    config.json 里有 session_secret（可用于伪造会话 Cookie）与口令哈希，
#    FIRST_RUN_PASSWORD.txt 里是明文口令 —— 这两个**永远不要提交**。
#    需要模板请用 config.example.json（其中的值都是占位符）。
# ===========================================================================

# ---- 运行时生成，含密钥 / 口令 --------------------------------------------
config.json
FIRST_RUN_PASSWORD.txt

# ---- 每台机器 / 每个人各自的状态（属于部署数据，不属于源码）--------------
user_state.json
desktop_shortcuts.json

# ---- 运行时缓存与临时产物 -------------------------------------------------
thumb_cache/
office_cache/
temp_zip/
logs/
*.log

# ---- 用户在界面上传的自定义壁纸（体积大且因人而异）----------------------
static/wallpapers/

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 本地 AI / 工具链产物（不属于本项目）-------------------------------
.dsh-vision-toolkit/

# ---- 编辑器与操作系统 -----------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
